{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgevena.dev/schemas/provider-compatibility/v1",
  "title": "Provider Compatibility Evidence v1",
  "type": "object",
  "required": ["schemaVersion", "id", "provider", "support", "verifiedAt", "expiresAt", "models", "fixtureHashes", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "provider": { "type": "string" },
    "support": { "enum": ["stable", "preview", "compatibility-only", "stale"] },
    "verifiedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" },
    "models": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "fixtureHashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }, "additionalProperties": false
}
