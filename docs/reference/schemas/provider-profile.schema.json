{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgevena.dev/schemas/provider-profile/v1",
  "title": "Provider Profile v1",
  "type": "object",
  "required": ["schemaVersion", "provider", "service", "kind", "support", "capabilities", "credentialSource", "storesSecrets"],
  "properties": {
    "schemaVersion": { "const": 1 }, "provider": { "type": "string" }, "service": { "type": "string" },
    "kind": { "enum": ["model-api", "local-model", "agent-host"] }, "support": { "enum": ["stable", "preview", "compatibility-only", "stale"] },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "defaultModel": { "type": ["string", "null"] },
    "allowedModels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "endpointProfile": { "type": ["string", "null"] }, "credentialSource": { "type": "object" },
    "compatibilityEvidenceId": { "type": ["string", "null"] }, "storesSecrets": { "const": false }
  }, "additionalProperties": true
}
