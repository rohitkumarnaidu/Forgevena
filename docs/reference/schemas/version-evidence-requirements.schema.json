{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rohitkumarnaidu.github.io/Forgevena/schemas/version-evidence-requirements.schema.json",
  "title": "Forgevena Version Evidence Requirements",
  "type": "object",
  "required": ["schemaVersion", "version", "state", "mandatory", "gates", "acceptance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "state": { "enum": ["required-not-collected", "partially-collected", "collected", "verified", "expired"] },
    "mandatory": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "gates": { "type": "object", "required": ["critical", "important", "standard"] },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
